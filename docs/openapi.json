      "title": "Facing"
     },
     "count": {
      "type": "integer",
      "maximum": 10000.0,
      "minimum": 0.0,
      "title": "Count"
     },
     "confidence": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.0,

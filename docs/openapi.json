     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "LoadIn": {
    "properties": {
     "seed": {
      "type": "integer",
      "maximum": 1000000.0,
      "minimum": 0.0,
      "title": "Seed",
      "default": 12
     }
    },
    "type": "object",
    "title": "LoadIn"
   },
   "LotIn": {
    "properties": {
     "store": {
      "type": "string",
      "maxLength": 40,
      "title": "Store"
     },
     "sku": {
      "type": "string",
      "maxLength": 60,
      "title": "Sku"
     },
     "qty": {
      "type": "integer",
      "title": "Qty"
     },
     "received_on": {
      "type": "string",
      "format": "date",
      "title": "Received On"
     },
     "label_expiry": {
      "anyOf": [
       {
        "type": "string",
        "format": "date"
       },
       {
        "type": "null"
       }
      ],
      "title": "Label Expiry"
     },
     "temperatures": {
      "items": {
       "$ref": "#/components/schemas/Reading"
      },
      "type": "array",
      "maxItems": 2000,
      "title": "Temperatures",
      "description": "the lot's logger in transit, one reading per interval"
     }
    },
    "type": "object",
    "required": [
     "store",
     "sku",
     "qty",
     "received_on"
    ],
    "title": "LotIn"
   },

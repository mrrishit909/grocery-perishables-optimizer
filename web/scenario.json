  {
   "title": "Twenty-six weeks of a grocery chain",
   "say": "An invented chain: twelve stores, twenty perishable items from strawberries to sushi, twenty-six weeks of sales, deliveries and waste under the chain's usual rule (order up to 1.6 times the same weekday's sales of the last four weeks). Sales stop when the shelf is empty, so on a stockout day they understate demand. The demand model reads those days as 'at least this much'; the shelf-life model learns from lots that spoiled, sold out or hit their date, with the heat each lot's logger recorded. Both are scored on the last four weeks against the simulation truth.",
   "calls": [
    {
     "key": "load",
     "as": "manager",
     "method": "POST",
     "path": "/v1/chain:load",
     "body": {
      "seed": 12
     }
    },
    {
     "key": "chain",
     "as": "viewer",
     "method": "GET",
     "path": "/v1/chain"
    }
   ]
  },
  {

  {
   "title": "What will not sell in time",
   "say": "For every item on Elm Street's shelves: the units the shelf-life model expects to spoil or pass their date before they sell at full price, the same with the date code alone, and the simulation truth.",
   "calls": [
    {
     "key": "risk",
     "as": "viewer",
     "method": "GET",
     "path": "/v1/expiration/risk?store=Elm%20Street"
    }
   ]
  },
  {
   "title": "When to mark the strawberries down",
   "say": "A dynamic program over the units on hand chooses a discount for each day until the date: the forecast, the price response fitted from past markdowns, and the chance tonight is the night the warm lot spoils. Then every option runs 1,500 times against real demand and the lot's real life: no markdown, the clerk's 30% on the last day, a flat 30% from day two, the optimiser, and the optimiser given the true parameters. Discounts of 40% or more wait for the store manager, who is not the planner.",
   "calls": [
    {
     "key": "md",
     "as": "planner",
     "method": "POST",
     "path": "/v1/markdown/solve",
     "body": {
      "store": "Elm Street",
      "sku": "Strawberries 1 lb"
     }
    },
    {
     "key": "self",
     "expect_error": true,
     "as": "planner",
     "method": "POST",
     "path": "/v1/markdown/{{md.actions.0.action_id}}/approve",
     "body": {
      "note": "approving my own"
     }
    },
    {
     "key": "approve",
     "as": "manager",
     "method": "POST",
     "path": "/v1/markdown/{{md.actions.0.action_id}}/approve",
     "body": {
      "note": "Warm lot, move it this weekend"
     }
    }
   ]
  },
  {
   "title": "A heatwave from Sunday",
   "say": "Friday's weather update brings 36-38 C from Sunday to Wednesday. Heat lifts demand for berries, salads and cut fruit and shortens shelf life, more for lots that ship on hot days. The forecast changes; the replenishment plan for the next six days orders up to a service-level quantile of each day's demand, counting only the stock the shelf-life model expects to survive, with each item's service level chosen by simulating the model's own world. On the truth it is set against the chain's rule and against the same plan without the weather update, with the margin-against-waste tradeoff across service levels.",
   "calls": [
    {
     "key": "heat",
     "as": "manager",
